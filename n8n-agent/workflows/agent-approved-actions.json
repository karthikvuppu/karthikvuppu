    {
      "id": "748afeb8-0b7c-553e-a900-e5b24464926e",
      "name": "Ask Owner",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [
        260,
        300
      ],
      "parameters": {
        "resource": "message",
        "operation": "sendAndWait",
        "chatId": "={{ $env.ALLOWED_TELEGRAM_IDS.split(',')[0].trim() }}",
        "subject": "Approval needed",
        "message": "={{ (() => { const i = $('When Called').first().json; const clean = s => String(s ?? '').replace(/[_*`\\[\\]]/g, ' ').slice(0, 1500); const lines = ['Action: ' + clean(i.action)]; ['what_it_does','to','subject','body','file_id','email','role','target'].forEach(k => { if (i[k]) lines.push(k + ': ' + clean(i[k])); }); return lines.join('\\n'); })() }}",
        "responseType": "approval",
        "approvalOptions": {
          "values": {
            "approvalType": "double",
            "approveLabel": "✅ Approve",
            "disapproveLabel": "❌ Decline"
          }
        },
        "options": {
          "appendAttribution": false,
          "limitWaitTime": {
            "values": {
              "limitType": "afterTimeInterval",
              "resumeAmount": 10,
              "resumeUnit": "minutes"
            }
          }
        }
      },
      "credentials": {
        "telegramApi": {
          "id": "agentTelegram01",
          "name": "Agent Telegram"
        }
      }
    },
    {
      "id": "362741ea-4348-5589-8ba3-e3d9445b13c6",
      "name": "Approved?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        520,
        300
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "8a97c657-9b41-5ea1-82bd-00dbd9d3e324",
              "leftValue": "={{ $json.data?.approved === true }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "98889ca9-4193-5703-ab3c-6db30e225f36",
      "name": "Declined",
