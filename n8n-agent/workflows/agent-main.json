              "leftValue": "={{ !!$json.message?.text && $env.ALLOWED_TELEGRAM_IDS.split(',').map(s => s.trim()).includes(String($json.message?.from?.id)) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
