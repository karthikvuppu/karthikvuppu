# You normally don't edit this: ./setup.sh creates .env for you (and generates the random secrets).
N8N_ENCRYPTION_KEY=
BROWSER_API_KEY=
BROWSER_APPROVAL_TOKEN=
TZ=Asia/Kolkata

# Telegram user IDs allowed to command the agent (comma-separated)
ALLOWED_TELEGRAM_IDS=5814061609

# Public hostname, e.g. myagent.duckdns.org (no https://, no slash)
N8N_HOST=
